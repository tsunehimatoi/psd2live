{
  "protocol": 2,
  "id": "psd2live.native.core",
  "name": "Core Native Modifiers (Rust)",
  "version": "1.0.0",
  "commands": {
    "windows-x86_64": ["psd2live-native-core.exe"],
    "linux-x86_64": ["psd2live-native-core"],
    "macos-aarch64": ["psd2live-native-core"]
  },
  "algorithms": [
    {
      "type": "psd2live.native.core/physics",
      "version": 1,
      "name": "Pendulum Physics (Native)",
      "category": "physics",
      "targets": ["mesh", "deformer", "part", "layer"],
      "reads": ["parameter", "physics"],
      "writes": ["physics"],
      "configSchema": {"type": "object"},
      "defaults": {}
    },
    {
      "type": "psd2live.native.core/motion",
      "version": 1,
      "name": "Motion Clip (Native)",
      "category": "motion",
      "targets": ["mesh", "deformer", "part", "layer"],
      "reads": ["parameter", "motion", "relations"],
      "writes": ["motion", "relations"],
      "configSchema": {"type": "object"},
      "defaults": {}
    },
    {
      "type": "psd2live.native.core/skin-clip",
      "authorContext": "face.skin-clip",
      "version": 1,
      "name": "Skin Clipping (Native)",
      "category": "face",
      "targets": ["mesh"],
      "requires": ["rig.scaffold"],
      "contextVersion": 2,
      "reads": ["mesh", "relations"],
      "writes": ["mesh", "relations"],
      "composableKinds": ["mesh", "part", "deformer", "hierarchy", "relations", "parameter"],
      "configSchema": {"type": "object"},
      "defaults": {}
    },
    {
      "type": "psd2live.native.core/eye-see-through",
      "authorContext": "eye.see-through",
      "version": 1,
      "name": "Eye See-Through (Native)",
      "category": "eye",
      "targets": ["mesh"],
      "requires": ["rig.scaffold"],
      "contextVersion": 2,
      "reads": ["*"],
      "writes": ["*"],
      "composableKinds": ["mesh", "part", "deformer", "hierarchy", "relations", "parameter"],
      "configSchema": {"type": "object"},
      "defaults": {}
    },
    {
      "type": "psd2live.native.core/brow-see-through",
      "authorContext": "brow.see-through",
      "version": 1,
      "name": "Brow See-Through (Native)",
      "category": "brow",
      "targets": ["mesh"],
      "requires": ["rig.scaffold"],
      "contextVersion": 2,
      "reads": ["*"],
      "writes": ["*"],
      "composableKinds": ["mesh", "part", "deformer", "hierarchy", "relations", "parameter"],
      "configSchema": {"type": "object"},
      "defaults": {}
    },
    {
      "type": "psd2live.native.core/expression-toggles",
      "authorContext": "expression.toggles",
      "version": 1,
      "name": "Expression Toggles (Native)",
      "category": "expression",
      "targets": ["mesh"],
      "requires": ["rig.scaffold"],
      "exclusiveFamily": "expression.toggles",
      "contextVersion": 2,
      "reads": ["mesh", "parameter", "physics"],
      "writes": ["mesh", "parameter", "physics"],
      "composableKinds": ["mesh", "part", "deformer", "hierarchy", "relations", "parameter", "physics"],
      "configSchema": {"type": "object"},
      "defaults": {}
    },
    {
      "type": "psd2live.native.core/swing",
      "version": 1,
      "name": "Swing (Native)",
      "category": "physics",
      "targets": ["mesh", "deformer"],
      "reads": ["*"],
      "writes": ["*"],
      "composableKinds": ["deformer", "mesh", "hierarchy"],
      "derivedOutputs": [
        {"kind": "deformer", "localName": "swing", "prefix": "Warp_Swing_", "numbered": true},
        {"kind": "physics", "localName": "swing", "prefix": "PhysicsSwing_", "suffixes": ["", "_X", "_Y"]}
      ],
      "configSchema": {"type": "object"},
      "defaults": {}
    },
    {
      "type": "psd2live.native.core/simulation",
      "version": 1,
      "name": "Simulation (Native)",
      "category": "clothing",
      "targets": ["mesh"],
      "reads": ["*"],
      "writes": ["*"],
      "composableKinds": ["mesh", "parameter", "physics"],
      "derivedOutputs": [
        {"kind": "physics", "localName": "physics", "prefix": "PhysicsSim_", "numbered": true}
      ],
      "configSchema": {"type": "object"},
      "defaults": {}
    },
    {
