      "authorContext": "expression.gloom",
      "version": 2,
      "name": "Expression Gloom v2 (Native)",
      "category": "expression",
      "targets": ["mesh"],
      "requires": ["rig.scaffold"],
      "contextVersion": 2,
      "reads": ["mesh", "parameter"],
      "writes": ["mesh", "parameter", "hierarchy"],
      "composableKinds": ["mesh", "part", "deformer", "hierarchy", "relations", "parameter"],
