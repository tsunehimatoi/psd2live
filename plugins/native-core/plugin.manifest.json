      "requires": ["rig.scaffold", "eye/fitted"],
      "contextVersion": 2,
      "reads": ["mesh", "parameter"],
      "writes": ["mesh", "part", "deformer", "hierarchy", "relations", "parameter"],
      "composableKinds": ["mesh", "part", "deformer", "hierarchy", "relations", "parameter"],
      "configSchema": {"type": "object"},
      "defaults": {}
    },
    {
      "type": "psd2live.native.core/brow-shape",
